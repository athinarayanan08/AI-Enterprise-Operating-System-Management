# Copy this file to .env and fill in real values as needed.

# JWT signing secret — change this to a long random string in production
NEXORA_SECRET_KEY=dev-only-change-me-in-production

# Optional: set this to enable real LLM responses in /api/chat.
# Leave blank to run in free demo mode.
OPENAI_API_KEY=

# Port the Express server listens on
PORT=8000
